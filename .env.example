# Cloudflare R2 Storage
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_ACCOUNT_ID=your_r2_account_id
R2_BUCKET=your_r2_bucket_name

# Solana RPC URL
RPC_URL=your_rpc_url
# Second keyed Solana RPC lane (Alchemy). Full HTTPS URL including the API key,
# e.g. https://solana-devnet.g.alchemy.com/v2/<api-key> (devnet now; swap to
# the mainnet URL at launch). Server-side only: never NEXT_PUBLIC_. When the
# Helius primary lane fails or rate-limits, traffic fails over to this lane.
ALCHEMY_RPC_URL=

# Pool Configuration
POOL_CONFIG_KEY=your_pool_config_key
# Strategies mirror feed: shared secret for the operator signal publish API.
# Sent as the x-strategies-admin header on POST /api/strategies/signals.
# When unset, publishing is rejected (fail closed). Generate with:
#   openssl rand -hex 32
STRATEGIES_ADMIN_SECRET=your_strategies_admin_secret
