# Cloudflare R2 Storage
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_ACCOUNT_ID=your_r2_account_id
R2_BUCKET=your_r2_bucket_name

# Solana RPC URL
RPC_URL=your_rpc_url

# Pool Configuration
POOL_CONFIG_KEY=your_pool_config_key
# Strategies mirror feed: shared secret for the operator signal publish API.
# Sent as the x-strategies-admin header on POST /api/strategies/signals.
# When unset, publishing is rejected (fail closed). Generate with:
#   openssl rand -hex 32
STRATEGIES_ADMIN_SECRET=your_strategies_admin_secret
